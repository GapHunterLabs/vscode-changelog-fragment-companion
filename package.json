{
  "name": "changelog-fragment-companion",
  "displayName": "Changelog Fragment Companion",
  "description": "Manage per-PR changelog fragments (changelog.d/<issue>.<type>.md, the towncrier convention) -- create and validate, no data leaves your editor.",
  "version": "0.1.0",
  "publisher": "GapHunterLabs",
  "icon": "images/icon.png",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Linters"
  ],
  "keywords": [
    "changelog",    "towncrier",    "versioning"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/GapHunterLabs/vscode-changelog-fragment-companion.git"
  },
  "bugs": {
    "url": "https://github.com/GapHunterLabs/vscode-changelog-fragment-companion/issues"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "changelogFragmentCompanion.newFragment",
        "title": "Changelog Fragment Companion: New Fragment"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "test": "tsc -p ./ && node --test \"out/test/**/*.test.js\""
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.2"
  }
}
